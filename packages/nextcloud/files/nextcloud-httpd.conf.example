# Example Apache httpd vHost for Nextcloud with PHP-FPM, the way the LFOps
# nextcloud role sets it up (https://github.com/Linuxfabrik/lfops). Copy it to
# /etc/httpd/conf.d/nextcloud.conf, set ServerName and reload httpd. Terminate
# TLS in front of it or add a :443 vHost with mod_ssl.
#
# The rules of Nextcloud's .htaccess are part of the vHost, so AllowOverride is
# off and httpd does not look for .htaccess files on every request.

<VirtualHost *:80>
    ServerName nextcloud.example.com

    ErrorLog logs/nextcloud-error.log
    CustomLog logs/nextcloud-access.log combined

    # uploads and the database migration on upgrades can take a while
    Timeout 600

    DocumentRoot /var/www/html/nextcloud
    <Directory /var/www/html/nextcloud>
        AllowOverride None
        Options None
        Require all granted
        <IfModule mod_dav.c>
            # Nextcloud answers WebDAV itself
            Dav off
        </IfModule>
    </Directory>

    # The data directory carries its own .htaccess, which AllowOverride None
    # ignores. Deny it here.
    <Directory /var/www/html/nextcloud/data>
        Require all denied
    </Directory>

    DirectoryIndex index.php index.html

    # Only a script that exists goes to PHP-FPM. httpd answers 404 for the
    # others itself, so a scanner probing for PHP files does not tie up a pool
    # worker per request. PATH_INFO requests (/index.php/apps/files) still match.
    <FilesMatch \.(php|phar)$>
        <If "-f %{REQUEST_FILENAME}">
            SetHandler "proxy:unix:/run/php-fpm/www.sock|fcgi://localhost"
        </If>
    </FilesMatch>

    #### Start of Nextcloud's .htaccess ####
    <IfModule mod_proxy_fcgi.c>
        SetEnvIfNoCase Authorization "(.+)" HTTP_AUTHORIZATION=$1
    </IfModule>

    # Avoid doubled headers by unsetting headers in the "onsuccess" table, then
    # add them to the "always" table: https://github.com/nextcloud/server/pull/19002
    <If "%{REQUEST_URI} =~ m#/login$#">
        # Only the login page needs an Origin or Referer header.
        Header onsuccess unset Referrer-Policy
        Header always set Referrer-Policy "same-origin"
    </If>
    <Else>
        Header onsuccess unset Referrer-Policy
        Header always set Referrer-Policy "no-referrer"
    </Else>

    Header onsuccess unset X-Content-Type-Options
    Header always set X-Content-Type-Options "nosniff"

    Header onsuccess unset X-Frame-Options
    Header always set X-Frame-Options "SAMEORIGIN"

    Header onsuccess unset X-Permitted-Cross-Domain-Policies
    Header always set X-Permitted-Cross-Domain-Policies "none"

    Header onsuccess unset X-Robots-Tag
    Header always set X-Robots-Tag "noindex, nofollow"

    Header onsuccess unset X-XSS-Protection
    Header always set X-XSS-Protection "1; mode=block"

    SetEnv modHeadersAvailable true

    <FilesMatch "\.(css|js|mjs|svg|gif|png|jpg|webp|ico|wasm|tflite)$">
        <If "%{QUERY_STRING} =~ /(^|&)v=/">
            Header set Cache-Control "max-age=15778463, immutable"
        </If>
        <Else>
            Header set Cache-Control "max-age=15778463"
        </Else>
    </FilesMatch>

    <FilesMatch "\.(otf|woff2?)$">
        Header set Cache-Control "max-age=604800"
    </FilesMatch>

    AddType image/svg+xml svg svgz
    AddType application/wasm wasm
    AddEncoding gzip svgz
    AddType text/javascript js mjs

    # In a vHost, unlike in .htaccess, the rules see the URL path with its
    # leading slash, and an internal rewrite needs PT to be mapped to a file
    # below DocumentRoot and handed to PHP-FPM.
    RewriteEngine on
    RewriteCond %{HTTP_USER_AGENT} DavClnt
    RewriteRule ^/$ /remote.php/webdav/ [L,R=302]
    RewriteRule .* - [env=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteRule ^/\.well-known/carddav /remote.php/dav/ [R=301,L]
    RewriteRule ^/\.well-known/caldav /remote.php/dav/ [R=301,L]
    RewriteRule ^/remote/(.*) /remote.php [QSA,L,PT]
    RewriteRule ^/(?:build|tests|config|data|lib|3rdparty|templates)/.* - [R=404,L]
    RewriteRule ^/\.well-known/(?!acme-challenge|pki-validation) /index.php [QSA,L,PT]
    RewriteRule ^/ocm-provider/?$ /index.php [QSA,L,PT]
    RewriteRule ^/(?:\.(?!well-known)|autotest|occ|issue|indie|db_|console).* - [R=404,L]

    # Clients like DAVx5 or Cyberduck send chunked requests, which arrive at
    # PHP-FPM without content. Buffer them so httpd sends a Content-Length.
    SetEnvIfNoCase Transfer-Encoding "chunked" proxy-sendcl=1

    # httpd 2.4.59 stopped passing the Content-Length set by the backend
    # (https://bz.apache.org/bugzilla/show_bug.cgi?id=68973)
    SetEnv ap_trust_cgilike_cl

    AddDefaultCharset utf-8
    #### End of Nextcloud's .htaccess ####
</VirtualHost>
