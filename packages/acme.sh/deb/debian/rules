#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

APPDIR = debian/acme.sh/usr/share/acme.sh

%:
	dh $@

override_dh_auto_build:
	# the man page from --help, as the Debian package does it. HOME: acme.sh
	# initialises its default config home below it on every call.
	HOME="$$(mktemp --directory)" ACME_PACKAGED=1 help2man \
		--name='Pure Unix shell script implementing the ACME client protocol' \
		--no-info \
		--version-string=$(DEB_VERSION_UPSTREAM) \
		./acme.sh > acme.sh.1

override_dh_auto_install:
	install -D -m 0755 acme.sh $(APPDIR)/acme.sh
	cp -r deploy dnsapi notify $(APPDIR)/
	rm -f $(APPDIR)/*/README.md
	install -D -m 0755 debian/acme.sh-wrapper debian/acme.sh/usr/bin/acme.sh
	install -D -m 0644 acme.sh.1 debian/acme.sh/usr/share/man/man1/acme.sh.1
	install -D -m 0644 acme.sh.completion debian/acme.sh/usr/share/bash-completion/completions/acme.sh

override_dh_fixperms:
	dh_fixperms
	# executable like in the Debian package, they carry a shebang
	find $(APPDIR) -name '*.sh' -exec chmod 0755 '{}' +
