Package: linuxfabrik-firewallfabrik
Architecture: all
Depends: ${misc:Depends},
         ${python3:Depends}
# The FirewallFabrik packages of mirror.plustech.de ship everything, including
# /usr/bin/fwf*, as one package named firewallfabrik. Conflicts/Replaces swap it
# for this one; Provides lets `apt install firewallfabrik` find this package. A
# package may conflict with a name it provides itself.
Conflicts: firewallfabrik
Provides: firewallfabrik (= ${binary:Version})
Replaces: firewallfabrik
Description: firewall policy compiler for iptables and nftables
 FirewallFabrik manages iptables and nftables policies for many Linux
 firewalls from one central policy database with reusable objects, and
 compiles them into deployment-ready shell scripts. It reads Firewall Builder
 (fwbuilder) files and continues its approach with a modern code base.
 .
 This package contains the core and the command line compilers fwf-ipt and
 fwf-nft. The GUI is in linuxfabrik-firewallfabrik-gui.

Package: linuxfabrik-firewallfabrik-gui
Architecture: all
Depends: ${misc:Depends},
         ${python3:Depends},
         hicolor-icon-theme,
         linuxfabrik-firewallfabrik (= ${binary:Version}),
         python3-pyside6.qtcore (>= 6.8),
         python3-pyside6.qtgui (>= 6.8),
         python3-pyside6.qtuitools (>= 6.8),
         python3-pyside6.qtwidgets (>= 6.8)
# No Conflicts: firewallfabrik here, it would hit the name the core package
# provides. The core package removes the PLUSTECH package; Replaces covers
# /usr/bin/fwf, which both ship.
Provides: firewallfabrik-gui (= ${binary:Version})
Replaces: firewallfabrik
Description: Qt GUI of FirewallFabrik
 FirewallFabrik manages iptables and nftables policies for many Linux
 firewalls from one central policy database with reusable objects, and
 compiles them into deployment-ready shell scripts.
 .
 This package contains the Qt GUI, fwf.
