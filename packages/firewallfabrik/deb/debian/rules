#!/usr/bin/make -f

APPID := ch.linuxfabrik.firewallfabrik
CORE := debian/linuxfabrik-firewallfabrik
GUI := debian/linuxfabrik-firewallfabrik-gui
TMP := debian/tmp

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_configure:
	# Older setuptools predates PEP 639: drop `license-files` (debian/copyright
	# covers the licenses) and the `setuptools >= 77.0.3` floor it needs.
	sed -i '/^license-files = /d; s/"setuptools >= 77.0.3"/"setuptools"/' pyproject.toml
	dh_auto_configure

override_dh_auto_test:
	# Skip the upstream test suite; the smoke test in package.conf runs the
	# compilers against the shipped example after installation.

override_dh_auto_install:
	dh_auto_install --destdir=$(TMP)
	# Split the installed tree: the gui package owns firewallfabrik/gui and fwf,
	# the core package everything else. pybuild picks the site directory, so
	# look it up instead of assuming one.
	set -e; \
	site="$$(cd $(TMP) && find . -type d -path '*-packages/firewallfabrik' | head -n 1 | xargs dirname)"; \
	test -n "$$site"; \
	mkdir -p $(GUI)/$$site/firewallfabrik $(GUI)/usr/bin $(CORE)/$$site $(CORE)/usr/bin; \
	mv $(TMP)/$$site/firewallfabrik/gui $(GUI)/$$site/firewallfabrik/; \
	mv $(TMP)/$$site/* $(CORE)/$$site/; \
	mv $(TMP)/usr/bin/fwf $(GUI)/usr/bin/; \
	mv $(TMP)/usr/bin/* $(CORE)/usr/bin/
	install -D -m 0644 assets/$(APPID).desktop $(GUI)/usr/share/applications/$(APPID).desktop
	install -D -m 0644 assets/$(APPID).xml $(GUI)/usr/share/mime/packages/$(APPID).xml
	install -D -m 0644 src/firewallfabrik/gui/ui/Icons/firewallfabrik.svg \
		$(GUI)/usr/share/icons/hicolor/scalable/apps/$(APPID).svg
	for size in 16 24 32 48; do \
		install -D -m 0644 src/firewallfabrik/gui/ui/Icons/firewallfabrik_$${size}.png \
			$(GUI)/usr/share/icons/hicolor/$${size}x$${size}/apps/$(APPID).png; \
	done
	# Not below /usr/share/doc: minimal images and many hosts skip docs on install.
	install -D -m 0644 examples/vdc.fwf $(CORE)/usr/share/linuxfabrik-firewallfabrik/examples/vdc.fwf
	install -D -m 0644 examples/README.md $(CORE)/usr/share/linuxfabrik-firewallfabrik/examples/README.md
	desktop-file-validate $(GUI)/usr/share/applications/$(APPID).desktop
