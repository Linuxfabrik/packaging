#!/usr/bin/make -f
# -*- makefile -*-
# Sample debian/rules that uses debhelper.
# This file was originally written by Joey Hess and Craig Small.
# As a special exception, when this file is copied by dh-make into a
# dh-make output file, you may use that output file without restriction.
# This special exception was added by Craig Small in version 0.37 of dh-make.

# Ported from the Debian fail2ban packaging (sid, 1.1.1-1) for Debian 12 and 13
# and Ubuntu 22.04 to 26.04. Linuxfabrik deltas:
# - version from package.conf (create-deb.sh writes debian/changelog)
# - debhelper compat 13 instead of 14, which Debian 12 and Ubuntu 22.04 and
#   24.04 do not have: no dh-sequence-cruft and dh-sequence-single-binary,
#   ${misc:Depends} spelled out, debian/fail2ban.postrm instead of
#   debian/fail2ban.purge
# - systemd-dev | systemd in Build-Depends, as systemd.pc is in systemd
#   before Debian 13 and Ubuntu 24.04
# - the tarball signature is checked with gpgv before the build, as
#   %gpgverify does in the RPM
# - Linuxfabrik as the maintainer; no autopkgtest, gbp, salsa-ci and watch
#   files
# Everything else follows Debian, so a later Debian packaging can be diffed
# against this one and merged.

# Uncomment this to turn on verbose mode.
export DH_VERBOSE=1

include /usr/share/dpkg/pkg-info.mk

%:
	dh $@ --buildsystem pybuild

DESTDIR=$(CURDIR)/debian/fail2ban
SYSTEMD_SYSTEM_UNIT_DIR = $(shell pkg-config --variable=systemdsystemunitdir systemd)
# Linuxfabrik: create-deb.sh puts the orig tarball and the upstream signature
# next to the source tree, and the key from files/ into debian/.
execute_before_dh_auto_configure:
	keyring="$$(mktemp --directory)/keyring.gpg" && \
	gpg --dearmor --output "$$keyring" debian/gpgkey-8738559E26F671DF9E2C6D9E683BF1BEBD0A882C.asc && \
	gpgv --keyring "$$keyring" ../$(DEB_VERSION_UPSTREAM).tar.gz.asc ../fail2ban_$(DEB_VERSION_UPSTREAM).orig.tar.gz

override_dh_clean:
	rm -rf fail2ban.egg-info
	-rm debian/fail2ban.init
	dh_clean
	: # auto generated
	-rm bin/fail2ban-python

override_dh_install:
	rm -f $(DESTDIR)/usr/share/doc/fail2ban/README.Solaris
	rm -f $(DESTDIR)/etc/fail2ban/paths-fedora.conf
	rm -f $(DESTDIR)/etc/fail2ban/paths-freebsd.conf
	rm -f $(DESTDIR)/etc/fail2ban/paths-osx.conf
	: # Remove explicitly created /var/run/fail2ban
	: # just to please lintian since init file will
	: # take care about it anyways
	rm -rf $(DESTDIR)/var/run/ $(DESTDIR)/run/
	: # Install monit configuration.  monit(1) reads /etc/monit/conf.d and
	: # /etc/monit/conf-enabled; Debian packages ship their snippet in
	: # conf-available for the admin to symlink.
	install -d $(DESTDIR)/etc/monit/conf-available
	install -m 644 files/monit/fail2ban $(DESTDIR)/etc/monit/conf-available/fail2ban
	: # Install bash completion
	install -d $(DESTDIR)/usr/share/bash-completion/completions
	install -m 644 files/bash-completion $(DESTDIR)/usr/share/bash-completion/completions/fail2ban
	: # Install systemd files.  Upstream dropped its tmpfiles.d snippet in
	: # 1.1.1; the unit's RuntimeDirectory= creates /run/fail2ban instead.
	install -d $(DESTDIR)$(SYSTEMD_SYSTEM_UNIT_DIR)
	install -m 644 build/fail2ban.service $(DESTDIR)$(SYSTEMD_SYSTEM_UNIT_DIR)
	: # Install default jail enabler
	install -m 644 debian/debian-files/jail.d_defaults-debian.conf $(DESTDIR)/etc/fail2ban/jail.d/defaults-debian.conf
	dh_install

override_dh_auto_test:
	FAIL2BAN_CONFIG_DIR="$(CURDIR)/config" LC_ALL=C.UTF-8 bin/fail2ban-testcases --verbosity=2 --no-network

override_dh_installexamples:
	dh_installexamples files/ipmasq-* files/nagios files/cacti

override_dh_installinit:
	cp -p files/debian-initd debian/fail2ban.init
	dh_installinit -- defaults 99
