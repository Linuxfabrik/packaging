FROM docker.io/library/debian:11

# Bullseye left Debian LTS on 2026-08-31. Since then deb.debian.org answers
# 404 for the security pool its index still lists, and archive.debian.org
# has not taken bullseye-security over yet. The image ships commented
# snapshot.debian.org lines pinned to its own build date, so switch apt to
# those. Check-Valid-Until is off because a snapshot's Release file expires.
# Verified against docker.io/library/debian:11 (snapshot 20260824) on
# 2026-09-23. build/smoke-test-package.sh does the same in its fresh container.
RUN sed --in-place \
        --expression='s|^deb http|# deb http|' \
        --expression='s|^# deb http://snapshot|deb http://snapshot|' \
        /etc/apt/sources.list && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends --yes python3-dev python3-pip python3-venv && \
    apt-get clean && \
    rm --recursive --force /var/lib/apt/lists/*

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends --yes build-essential ca-certificates curl debhelper devscripts && \
    apt-get clean && \
    rm --recursive --force /var/lib/apt/lists/*
