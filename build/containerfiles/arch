# Arch Linux is a rolling release, so there is no version tag: the target distro
# is simply `arch`.
FROM docker.io/library/archlinux:latest

# Re-initialise the packaged keyring first: on a base image that has drifted from
# the current repositories, signatures otherwise fail to verify ("unknown trust").
# Then install the build toolchain. base-devel brings makepkg; sudo lets the
# unprivileged build user install dependencies via pacman during makepkg -s.
RUN pacman-key --init && \
    pacman-key --populate archlinux && \
    pacman --sync --refresh --noconfirm archlinux-keyring && \
    pacman --sync --sysupgrade --noconfirm --needed base-devel sudo && \
    pacman --sync --clean --clean --noconfirm

# makepkg refuses to run as root. Create an unprivileged build user and allow it
# to install build/runtime dependencies through pacman without a password.
RUN useradd --create-home builder && \
    echo 'builder ALL=(ALL) NOPASSWD: /usr/bin/pacman' > /etc/sudoers.d/builder && \
    chmod 0440 /etc/sudoers.d/builder
