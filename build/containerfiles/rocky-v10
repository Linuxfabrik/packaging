# Don't use Rocky containers from docker.io/library as they are out of date.
FROM docker.io/rockylinux/rockylinux:10

# Use dl.rockylinux.org, which sits behind the Fastly CDN, instead of the mirrorlist.
# The mirrorlist hands out single mirrors, and on GitHub's runners some of them
# delivered BaseOS at 100 kB/s or stalled dnf completely (run 40189467280).
RUN sed --in-place \
        --expression='s|^mirrorlist=|#mirrorlist=|' \
        --expression='s|^#baseurl=http://dl.rockylinux.org|baseurl=https://dl.rockylinux.org|' \
        /etc/yum.repos.d/[Rr]ocky*.repo

# Install Python 3
RUN dnf --assumeyes install --nodocs gcc python3-pip python3-devel && \
    dnf clean all

# Enable crb repo
RUN dnf --assumeyes install --nodocs dnf-plugins-core && \
    dnf config-manager --set-enabled crb && \
    dnf clean all

RUN dnf --assumeyes install --nodocs epel-release && \
    dnf clean all

RUN dnf --assumeyes install --nodocs rpmdevtools && \
    dnf clean all

# for compiling selinux policies
# if using `registry.access.redhat.com/ubi10/ubi`, this results in
#   No match for argument: selinux-policy-devel
#   Error: Unable to find a match: selinux-policy-devel
#   Error: building at STEP "RUN dnf --assumeyes install --nodocs make selinux-policy-devel && dnf clean all": while running runtime: exit status 1
RUN dnf --assumeyes install --nodocs make selinux-policy-devel && \
    dnf clean all
