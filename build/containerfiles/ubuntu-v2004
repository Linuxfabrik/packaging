FROM docker.io/library/ubuntu:20.04

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends --yes python3.9-dev python3.9-venv && \
    apt-get clean && \
    rm --recursive --force /var/lib/apt/lists/*

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends --yes build-essential ca-certificates curl debhelper devscripts && \
    apt-get clean && \
    rm --recursive --force /var/lib/apt/lists/*
